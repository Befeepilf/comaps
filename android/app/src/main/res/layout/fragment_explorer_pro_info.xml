<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?appBackground"
    android:clipToPadding="false"
    android:fadeScrollbars="false"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:clipToPadding="false"
      android:orientation="vertical"
      android:padding="@dimen/margin_base">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/explorer_pro_info_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_base"
        android:text="@string/explorer_pro_info_title"
        android:textAppearance="@style/MwmTextAppearance.Headline6"
        android:textColor="?android:textColorPrimary" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/explorer_pro_info_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.15"
        android:text="@string/explorer_pro_info_body"
        android:textAppearance="@style/MwmTextAppearance.Body1"
        android:textColor="?android:textColorPrimary" />

  </LinearLayout>
</ScrollView>
